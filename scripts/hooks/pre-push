#!/bin/sh
# Nothing reaches origin (whose main deploys to GitHub Pages) unless HEAD is a tree a passing build checked
# (2026-11-05). The second lock behind pre-commit: it also stops a commit made with --no-verify.
root=$(git rev-parse --show-toplevel)
head=$(git rev-parse 'HEAD^{tree}') || exit 1
if [ ! -f "$root/.build-ok" ] || [ "$head" != "$(cat "$root/.build-ok")" ]; then
  echo "pre-push: HEAD's tree ($head) isn't the one the last passing build checked. Nothing is pushed or deployed." >&2
  exit 1
fi
